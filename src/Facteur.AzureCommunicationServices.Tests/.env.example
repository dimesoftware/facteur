# Azure Communication Services Configuration
# Copy this file to .env and fill in your actual values

# Required: Your Azure Communication Services connection string
# Get this from Azure Portal > Your ACS Resource > Settings > Keys
COMMUNICATION_SERVICES_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-access-key-here

# Required: Your verified sender email address
# This is the MailFrom address from your verified domain
# Format: donotreply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net
ACS_SENDER_ADDRESS=donotreply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net

# Required: Email address to receive test emails
ACS_RECIPIENT_ADDRESS=your-test-email@example.com

# Optional: Additional recipients for CC/BCC tests
# If not set, will default to ACS_RECIPIENT_ADDRESS
ACS_CC_ADDRESS=cc-recipient@example.com
ACS_BCC_ADDRESS=bcc-recipient@example.com

# Optional: Second recipient for multiple recipient tests
# If not set, will default to ACS_RECIPIENT_ADDRESS
ACS_RECIPIENT_ADDRESS_2=second-recipient@example.com
